# ══════════════════════════════════════════════════════════════
# 请柬配置示例 —— 复制为 .env 后按需修改
#
#   cp .env.example .env
#
# .env 已被 .gitignore 忽略，真实信息不会进入 Git 历史。
# 部署到 Cloudflare Pages 时，请把同样的键值填入
#   Dashboard → Settings → Environment variables
# （可分别配置 Production / Preview 环境）
#
# ⚠️ 隐私边界：VITE_ 前缀的变量会在构建期内联进浏览器产物。
#    这意味着站点访问者（以及任何查看网页源码的人）能看到这些内容 ——
#    这是必然的，请柬信息本就要给宾客看。环境变量的作用是让真实信息
#    **不进入公开的开源仓库**，而不是对访问者保密。
# ══════════════════════════════════════════════════════════════

# ── 双方与时间 ──────────────────────────────────────────────
VITE_GROOM=新郎
VITE_BRIDE=新娘
# ISO 8601（含时区），用于倒计时
VITE_DATE_ISO=2026-10-18T11:30:00+08:00
# 封面大号日期
VITE_DATE_TEXT=2026.10.18
VITE_WEEKDAY=星期日
VITE_TIME_TEXT=11:30

# ── 场地 ────────────────────────────────────────────────────
VITE_VENUE_NAME=婚礼场地
VITE_VENUE_ADDRESS=请在此填写详细地址
# 坐标为 gcj-02（高德/腾讯地图通用），用于「一键导航」
# 获取方式：在高德地图搜索场地 → 右键 → 复制坐标
VITE_VENUE_LAT=30.2436
VITE_VENUE_LNG=120.1536
VITE_VENUE_PHONE=

# ── 文案 ────────────────────────────────────────────────────
VITE_KICKER=诚邀您见证我们的婚礼
VITE_CLOSING=期待与你相见
VITE_GO_BUTTON=查看详情
VITE_HINT=哈哈镜~来戳我

# ── 封面图裁切焦点（0~1）──────────────────────────────────
# 人脸或主体偏上时把 Y 调小（如 0.35）
VITE_HERO_FOCAL_X=0.5
VITE_HERO_FOCAL_Y=0.4

# ── 部署地址（用于 og:url 与微信/社交分享图，需为绝对地址）──
# 例：https://your-domain.com
VITE_SITE_URL=

# ══════════════════════════════════════════════════════════════
# 进阶：直达航班（可选）
#
# 以「飞机」卡片展示在「如何前往」中，与「自驾」同款样式。
# 只需城市与班期（顺序即展示顺序）；不设置则不渲染。
# 单行 JSON 数组。
# ══════════════════════════════════════════════════════════════
# VITE_FLIGHTS_JSON=[{"city":"示例市","days":"每日一班"},{"city":"另一城市","days":"每周一、三、五、日"},{"city":"第三城","days":"每日两班直飞"}]

# 其他城市中转建议，以「其他城市」卡片展示（不设置则不渲染）
# VITE_TRANSIT_NOTE=可先乘机抵达中转城市 ✈️，再转乘动车/高铁前往，约 2.5 小时。

# ══════════════════════════════════════════════════════════════
# 高德地图嵌入（可选）
#
# 配置后「地点」板块会内嵌交互式地图（滚动到该板块才懒加载高德 JS API）。
# 未配置则只显示导航链接，不渲染地图。
# 获取：console.amap.com → 应用管理 → 创建应用 → 添加 Key（类型选 Web端(JS API)），
# 同一应用下可查看配套的安全密钥。建议在控制台为该 Key 配置域名白名单。
# 注意：JS API 的 key 属公开凭据（前端必然可见），安全防线在域名白名单，
# 切勿复用「Web服务」类型的 key（那是服务端凭据）。
# ══════════════════════════════════════════════════════════════
# VITE_AMAP_KEY=你的key
# VITE_AMAP_SECURITY_CODE=与key配套的安全密钥

# ══════════════════════════════════════════════════════════════
# 进阶：数组字段（流程 / 交通指引）
#
# 上面的标量变量覆盖不到数组字段，用下面两个变量一次性覆盖
# （单行 JSON 数组，**必须是数组**，不是对象；非法会在构建期报错）。
#
# 优先级：VITE_SITE_JSON  <  数组变量  <  标量变量
#
# ⚠️ 值里不要加单引号：JSON 用双引号。整行不能换行。
# ══════════════════════════════════════════════════════════════

# 「如何前往」四个格子：icon 为 emoji（留空则显示 ·）
# VITE_HOWTOGET_JSON=[{"icon":"🚗","title":"自驾","text":"导航至婚礼场地，凭请柬免费停车 3 小时。"},{"icon":"🚇","title":"地铁","text":"地铁 5 号线 A 口出，步行 600 米。"},{"icon":"🚄","title":"高铁","text":"高铁站打车约 25 分钟。"},{"icon":"🅿️","title":"停车","text":"地下车库 B1 层。"}]

# 「当日流程」：time 为左侧显示的时间
# VITE_SCHEDULE_JSON=[{"time":"11:00","title":"迎宾签到","text":"一层门厅签到，领取伴手礼"},{"time":"11:30","title":"午宴入席","text":"二层宴会厅，请按桌号就座"},{"time":"12:08","title":"婚礼仪式","text":"诚邀您一同见证"},{"time":"13:00","title":"午宴开席","text":"佳肴与祝福，都不辜负"}]

# ══════════════════════════════════════════════════════════════
# 进阶：整块 JSON 覆盖
#
# 一次性覆盖整个配置（对象深合并，数组整体替换）。
# 一般优先用上面的数组变量，更易读。
#
# 注意：JSON 必须写成**单行**，且不能有换行。
# ══════════════════════════════════════════════════════════════
# VITE_SITE_JSON={"schedule":[{"time":"11:00","title":"迎宾签到","text":"签到台领取伴手礼"},{"time":"11:30","title":"午宴入席","text":"请按桌号就座"}],"howToGet":[{"icon":"🚗","title":"自驾","text":"导航至婚礼场地，凭请柬免费停车 3 小时。"}]}

# ══════════════════════════════════════════════════════════════
# ⚠️ 面板密码 / 会话密钥：**故意不放这里**
#
# 本文件所有变量都是 VITE_ 前缀，会被内联进公开的 JS bundle —— 任何人
# 查看网页源码即可读到。面板密码若放这里，认证等于形同虚设。
#
# 正确做法：配在**服务端**，浏览器永远拿不到。
#
# ① 部署（Cloudflare Pages）
#    Dashboard → Settings → Environment variables → Encrypt，添加：
#      DASHBOARD_PASSWORD = 你的面板密码
#      SESSION_SECRET     = 随机 32 字节（生成：openssl rand -hex 32）
#    未配置时 /dashboard 会直接报错拒绝服务（**没有默认密码**）。
#
# ② 本地开发
#    新建 .dev.vars（已被 gitignore）：
#      printf 'DASHBOARD_PASSWORD=你的密码\nSESSION_SECRET=%s\n' "$(openssl rand -hex 32)" > .dev.vars
#    然后用 npx wrangler pages dev dist 启动（vite dev 没有 Functions）
# ══════════════════════════════════════════════════════════════

# ── 小贴士（可选）：以「一点小贴士」卡片展示在交通之后 ──────
# VITE_TRAVEL_TIP=这里四季如春、冬日暖阳，欢迎提前来晒晒太阳 ☀️；也在川滇交界，去大理丽江很方便，不妨顺路走走 🛣️
